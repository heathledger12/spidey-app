rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kishorekumar1432006@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default catch-all denies all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check collection for connection validation
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection: Personal account data protected by owner & admin check
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if (isOwner(userId) && request.resource.data.uid == resource.data.uid) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Opinions Collection: Shared opinions database with public read and author/admin write
    match /opinions/{opinionId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        (request.resource.data.userId == request.auth.uid || isAdmin()) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 5 &&
        request.resource.data.content.size() <= 20000;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
      );
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Admins Collection: Verified admin identities
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
